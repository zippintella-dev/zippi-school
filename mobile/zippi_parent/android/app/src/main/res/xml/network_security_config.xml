<?xml version="1.0" encoding="utf-8"?>
<!--
  Production posture: HTTPS only.

  ⚠ This app carries a child's live location and today's handover code. Plain
  HTTP on a shared school Wi-Fi is trivially readable by anyone on the network,
  so cleartext is denied outright here. The debug manifest overrides this to
  allow the LAN ranges a developer's Laravel server runs on — see
  src/debug/network_security_config.xml. That override never ships in a release
  build, because the release build uses THIS file.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
