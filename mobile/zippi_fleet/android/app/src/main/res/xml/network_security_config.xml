<?xml version="1.0" encoding="utf-8"?>
<!--
  Production posture: HTTPS only.

  ⚠ This app carries a child's live location and today's handover code. Plain
  HTTP on a shared school Wi-Fi is trivially readable by anyone on the network,
  so cleartext is denied outright here.

  Debug builds overlay this with src/debug/res/xml/network_security_config.xml —
  same resource name in the `debug` source set, which is how Gradle lets one
  variant replace another's resource. That override permits cleartext so the app
  can reach `php artisan serve` over a LAN address, and it never ships: a
  release build has no debug source set, so it uses THIS file.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
