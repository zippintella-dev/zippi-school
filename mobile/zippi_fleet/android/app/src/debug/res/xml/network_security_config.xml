<?xml version="1.0" encoding="utf-8"?>
<!--
  DEBUG BUILDS ONLY. This file overlays the one in src/main/res/xml by having
  the same resource name in the `debug` source set, so a release build never
  sees it and keeps the HTTPS-only posture next door.

  ⚠ WHY THE EXCEPTION EXISTS. In development the Laravel server is
  `php artisan serve` on somebody's laptop, reached over plain HTTP at whatever
  address DHCP handed it that morning — 10.0.2.2 from the Android emulator, a
  192.168.x.x or 172.16.x.x lease from a handset on the same Wi-Fi. Android's
  network security config matches exact hosts and cannot express "any private
  range", and the whole point of the server field on the login screen is that
  the address moves without a rebuild (see lib/config.dart). So debug permits
  cleartext outright rather than pinning an IP that is wrong by Thursday.

  ⚠ THIS MUST NEVER BE THE RELEASE POSTURE. The app carries a child's live
  position and the day's handover code; cleartext on a school's shared Wi-Fi is
  readable by everyone else on it. src/main/res/xml/network_security_config.xml
  is the file that ships, and it denies cleartext.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
